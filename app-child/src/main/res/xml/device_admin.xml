<?xml version="1.0" encoding="utf-8"?>
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- Lock screen and device reset -->
        <limit-password />
        <watch-login />
        <reset-password />
        <force-lock />
        <wipe-data />

        <!-- Disable features -->
        <disable-camera />
        <disable-keyguard-features />
    </uses-policies>
</device-admin>
